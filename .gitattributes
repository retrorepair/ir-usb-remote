# Normalise line endings so the repo is identical on Windows, macOS and Linux.
* text=auto eol=lf

# Keep CRLF for PowerShell: some older hosts are unhappy with LF-only scripts.
*.ps1 text eol=crlf

# Generated database: large, machine-written, never worth a diff.
app/resources/db/*.json       -diff linguist-generated
app/resources/db/buttons/*.json -diff linguist-generated
