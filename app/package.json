{
  "name": "ir-remote-configurator",
  "version": "1.0.0",
  "description": "Configure an IR USB Remote receiver: identify your remote, correct its button layout, and map buttons to keystrokes.",
  "author": "Open IR",
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --config electron-builder.yml --win",
    "dist:dir": "npm run build && electron-builder --config electron-builder.yml --win --dir",
    "db:build": "node ../tools/db-build/build-db.mjs",
    "check:protocol": "node ../tools/check-protocol-sync.mjs"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/w3c-web-hid": "^1.0.7",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.8"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  }
}
